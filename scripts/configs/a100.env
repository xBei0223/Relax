# 各实验的差异通过独立进程的环境变量传入，并保存到 effective-env.txt
DATA_DIR="${DATA_DIR:-/data/magicbrush-128}"
DATASET_SIZE="${DATASET_SIZE:-128}"
MODE=lora
GLOBAL_BATCH_SIZE=4
SEED=42
MAX_PIXELS="${MAX_PIXELS:-1048576}"
CONDITIONING_IMAGES=1
ATTENTION_IMPLEMENTATION=flash_attention_2
DETERMINISTIC_ATTENTION="${DETERMINISTIC_ATTENTION:-0}"
PREFIX_GRADIENT_CHECKPOINTING=1
IMAGE_PREFETCH_DEPTH=2
IMAGE_PREFETCH_WORKERS=2
BASELINE_STATS_ENABLED="${BASELINE_STATS_ENABLED:-0}"
BASELINE_WARMUP_STEPS=1
CONDITION_CACHE_ENABLED="${CONDITION_CACHE_ENABLED:-0}"
CONDITION_CACHE_MAX_ENTRIES=256
# A2 与 A3 已验证每个 rank 12 GiB 的共同预算。
CONDITION_CACHE_MAX_BYTES="${CONDITION_CACHE_MAX_BYTES:-12884901888}"
STEPS="${STEPS:-96}"
SAVE_CHECKPOINT="${SAVE_CHECKPOINT:-0}"
